{
  "name": "world-conquest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
