    "dev": "pnpm --filter @wc/web dev",
    "test:integration": "pnpm --filter @wc/integration integration"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "supabase": "^2.121.0",
    "typescript": "^7.0.2"
